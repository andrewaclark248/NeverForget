<div class="row  pb-5 pt-4 bg-white border-bottom border-dark pe-3 ps-3">
	<div class="col-2">
		<div > 
		  <span class="fs-5 fw-bold">Dashboard</span>
		</div>
	</div>
	<div class="col-10">
    <div class="float-end " >
      <div class="btn-group" role="group" aria-label="Basic outlined example">
        <button type="button" class="btn btn-outline-dark bg-dark text-white">Password Security</button>
        <button type="button" class="btn btn-outline-dark">Account Security</button>
        <button type="button" class="btn btn-outline-dark">Dark Web Monitoring</button>
      </div>	
    </div>
  </div>
</div>
<div class="bg-white  border-top-0 border-bottom border-dark" >
  <div class="card-header bg-primary rounded-0 ">
    <span class="fs-5 text-white">Password Security Score</span>
  </div>
  <% if @show_security_score %>
    <div class="row">
      <div class="col-2"></div>
      <div class="col-4">
        <div class=" pt-4">
          <div class="ldBar label-center progressBarCircle" data-value=<%=@security_score%> data-preset="circle" data-stroke-width="8" data-pattern-size="200" > 
          </div>
        </div>    
      </div>
      <div class="col-6">
        <div class=" ">
          <div class="row pb-3 pt-5">
            <div class="col-4">
              <span class="pe-2 "><small>Number of Weak Passwords:</small></span>
            </div>
            <div class="col-1">
              <span>
                <span class="text-danger fw-bold"><%= @num_weak_passwords %></span>
              </span>
            </div>
            <div class="col-4">
              <button class="btn btn-dark btn-sm showHideWeakPasswords">Show Weak Passwords</span>
            </div>
          </div>
          <div class="row pb-3">
            <div class="col-4">
              <span class="pe-2"><small>No. of Passwords that are the same:</small></span>
            </div>
            <div class="col-1">
              <span>
                <span class="text-danger fw-bold"><%= @same_passwords_count %></span>
              </span>
            </div>
            <div class="col-4">
              <button class="btn btn-dark btn-sm showDuplicatePasswords">Show Duplicate Passwords</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="row">
      <div class="col-12"> 
        <center>
          <div class="pt-3 pb-3"> 
            <div class="pb-3">
              <span class="fw-bold text-dark">Add A Password To See Your Securty Score</span><br>
            </div>
            <%= link_to "Create Password", new_user_password_path, class: "btn btn-danger" %>

          </div>
        </center>
      </div>
    </div>
  <% end %>
</div>

<div class="card rounded-0  weakPasswordsPanel d-none border-0 border-bottom border-dark">
  <div class="card-header bg-white">
    <span class="fw-bold">Weak Passwords</span>
  </div>
	<div class="list-group-item" > 
		<div class="row pb-1 pt-1">
			<div class="col-5">
				<span class="fw-bold ps-3">Username</span>
			</div>
			<div class="col-2">
				<span class="fw-bold">URL's</span>
			</div>
			<div class="col-4">
				<span class="fw-bold">Password Strength</span>
			</div>
			<div class="col-1">
				<span class="fw-bold">Edit</span>
			</div>
		</div>
	</div>
	<% @weak_passwords&.each do |password| %>
    <div class="list-group-item border border-1 active-password-table bg-white">
      <div class="row pb-1 pt-1">
        <div class="col-5">
          <span class="fw-bold ps-3"><%= password.username %></span>
        </div>
        <div class="col-2">
          <span class="fw-bold"><%= password.urls.pluck(:name).join(", ") %></span>
        </div>
        <div class="col-4">
					<span class="badge <%= get_pwd_color(password.pwd_strength) %>"><%= password.pwd_strength&.upcase %></span>
        </div>
        <div class="col-1">
          <%= link_to edit_user_password_path(password) do %>
            <button class="btn btn-light">
              <i class="fa fa-pen-to-square"></i>
              Edit
            </button>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<div class="card rounded-0  samePasswordPanel d-none border-0 border-bottom border-dark">
  <div class="card-header bg-white">
    <span class="fw-bold">Duplicate Passwords</span>
  </div>

	<div class="list-group-item " >
		<div class="row pb-1 pt-1">
			<div class="col-5">
				<span class="fw-bold ps-3">Username</span>
			</div>
			<div class="col-2">
				<span class="fw-bold">URL's</span>
			</div>
			<div class="col-4">
				<span class="fw-bold">Password Strength</span>
			</div>
			<div class="col-1">
				<span class="fw-bold">Edit</span>
			</div>
		</div>
	</div>

	<% @same_passwords&.each do |password| %>
    <div class="list-group-item border border-1 active-password-table bg-white">
      <div class="row pb-1 pt-1">
        <div class="col-5">
          <span class="fw-bold ps-3"><%= password.username %></span>
        </div>
        <div class="col-2">
          <span class="fw-bold"><%= password.urls.pluck(:name).join(", ") %></span>
        </div>
        <div class="col-4">
					<span class="badge <%= get_pwd_color(password.pwd_strength) %>"><%= password.pwd_strength&.upcase %></span>
        </div>
        <div class="col-1">
          <%= link_to edit_user_password_path(password) do %>
            <button class="btn btn-light">
              <i class="fa fa-pen-to-square"></i>
              Edit
            </button>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>