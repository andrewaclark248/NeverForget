<div class="row  mb-4 mt-4">
	<div class="col-6">
		<div style="padding-left: 30px;">
		<span class="fs-5 fw-bold">Dashboard</span>
		</div>
	</div>
	<div class="col-6 ">
	</div>
</div>
<div class="card-group border-top border-bottom border-secondary">
  <div class="card pt-3" style="max-width:35%;">
      <center>
        <span class="fs-5">Password Security Score</span>
      </center>
    <div class="card-body">

        <div class="progress mx-auto" data-value='80'>
          <span class="progress-left">
                        <span class="progress-bar border-primary"></span>
          </span>
          <span class="progress-right">
                        <span class="progress-bar border-primary"></span>
          </span>
          <div class="progress-value w-100 h-100 rounded-circle d-flex align-items-center justify-content-center">
            <div class="h2 font-weight-bold">80<span class="small">%</span></div>
          </div>
        </div>


    </div>
  </div>

  <div class="card">
    <div class="card-header bg-white">
        <span class="fs-5">Password Score Breakdown</span>
    </div>
    <div class="card-body">
      <div class="row pb-3">
        <div class="col-5">
          <span class="pe-2">Number of Weak Passwords:</span>
        </div>
        <div class="col-7">
          <span>
            <a href="#" class="link-danger">12</a>
          </span>
        </div>
      </div>
      <div class="row">
        <div class="col-5">
          <span class="pe-2"># of Passwords that are the same:</span>
        </div>
        <div class="col-7">
          <span>
            <a href="#" class="link-danger">8</a>
          </span>        
        </div>
      </div>

    </div>
  </div>
</div>

