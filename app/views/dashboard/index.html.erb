<div class="row  pb-4 pt-4 bg-white" style="  border-bottom: solid #B8B8B8;">
	<div class="col-2">
		<div style="padding-left: 30px;">
		  <span class="fs-5 fw-bold">Dashboard</span>
		</div>
	</div>
	<div class="col-10">
    <div class="float-end " style="padding-right: 50px;">
      <div class="btn-group" role="group" aria-label="Basic outlined example">
        <button type="button" class="btn btn-outline-danger">Password Security</button>
        <button type="button" class="btn btn-outline-danger">Account Security</button>
        <button type="button" class="btn btn-outline-danger">Dark Web Monitoring</button>
      </div>	
    </div>
  </div>
</div>
<div class="card-group  border-top-0 ">
  <div class="card pt-3 rounded-0" style="max-width:35%;">
      <center>
        <span class="fs-5">Password Security Score</span>
      </center>
    <div class="card-body">

        <div class="progress mx-auto" data-value='80'>
          <span class="progress-left">
                        <span class="progress-bar border-primary"></span>
          </span>
          <span class="progress-right">
                        <span class="progress-bar border-primary"></span>
          </span>
          <div class="progress-value w-100 h-100 rounded-circle d-flex align-items-center justify-content-center">
            <div class="h2 font-weight-bold">80<span class="small">%</span></div>
          </div>
        </div>


    </div>
  </div>
  <div class="card rounded-0">
    <div class="card-header bg-white">
        <span class="fs-5">Password Score Breakdown</span>
    </div>
    <div class="card-body">
      <div class="row pb-3">
        <div class="col-5">
          <span class="pe-2">Number of Weak Passwords:</span>
        </div>
        <div class="col-2">
          <span>
            <span class="text-danger"><%= @num_weak_passwords %></span>
          </span>
        </div>
        <div class="col-4">
          <button class="btn btn-danger showHideWeakPasswords">Show Weak Passwords</span>
        </div>
      </div>
      <div class="row pb-3">
        <div class="col-5">
          <span class="pe-2">No. of Passwords that are the same::</span>
        </div>
        <div class="col-2">
          <span>
            <span class="text-danger">12</span>
          </span>
        </div>
        <div class="col-4">
          <button class="btn btn-danger">Show Duplicate Passwords</span>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="card rounded-0  weakPasswordsPanel d-none">
  <div class="card-header bg-white">
    <span class="fw-bold">Weak Passwords</span>
  </div>

	<% @weak_passwords&.each_with_index do |password, index| %>
    <div class="list-group-item border border-1 active-password-table bg-white">
      <div class="row pb-1 pt-1">
        <div class="col-5">
          <span class="fw-bold ps-3"><%= password.username %></span>
        </div>
        <div class="col-2">
          <span class="fw-bold"><%= password.urls.pluck(:name).join(", ") %></span>
        </div>
        <div class="col-4">
          <span class="fw-bold <%= get_pwd_color(password.pwd_strength) %>"><%= password.pwd_strength&.upcase %></span>
        </div>
        <div class="col-1">
          <%= link_to edit_user_password_path(password) do %>
            <button class="btn btn-light">
              <i class="fa fa-pen-to-square"></i>
              Edit
            </button>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>


</div>