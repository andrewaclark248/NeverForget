
<center>
	<%= link_to "Purchase New Phone Number", purchase_phones_path,class: "btn btn-danger"%>
</center>
<br>
<br>

<div class="card">
  <div class="card-header">
    <h3>Your Phone Numbers</h3>
  </div>
  <div class="card-body">

	  <table class="table table-striped">
	    <thead>
	      <tr>
	        <th>Phone Number</th>
	        <th>Manage</th>
	      </tr>
	    </thead>
	    <tbody>
		    <% @phones.each do |phone| %>
		    	<tr>
                	<td>
		        		<%= phone.phone_number %>
		        	</td>
		        	<td>
	                    <%= link_to "Manage", manage_phone_path(phone),class: "link-primary"%>
		        	</td>
		      	</tr>
		   	<% end %>
	  	</tbody>
	  </table>

  </div>
</div>