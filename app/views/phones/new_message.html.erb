<center>
	<h3>Send Message</h3>
</center>
<br>
<br>
<div class="row">
    <div class="col"></div>
    <div class="col-8">
        <div class="card" style="">
        <div class="card-body">
            <%= simple_form_for :message, url: send_message_phone_path(@phone.id) do |f| %>
                <%= f.input :from, input_html: { value: @phone.phone_number }, disabled: true%> <br>
                <%= f.input :to %> <br>
                <%= f.label "Message" %>
                <%= f.text_area :message, style: "width: 100%; height: 100px;" %>
                <br>
                <br>
                <%= f.button :submit, class: "btn btn-danger"  %>
            <% end %>
        </div>
        </div>
    </div>
    <div class="col"></div>
</div>

