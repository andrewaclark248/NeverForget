<center>
	<%= link_to "Send Message", new_message_phone_path(id: params[:id]),class: "btn btn-danger"%>
</center>
<br>
<br>

<div class="card">
  <div class="card-header">
    <h3>List Messages</h3>
  </div>
  <div class="card-body">

	  <table class="table table-striped">
	    <thead>
	      <tr>
	        <th>to</th>
	        <th>From</th>
			<th>Message</th>
	        <th>View</th>
	      </tr>
	    </thead>
	    <tbody>
		    <% @messages&.each do |message| %>
		    	<tr>
		        	<td>
		        		<%= message.to %>
		        	</td>
		        	<td>
		        		<%= message.from %>
		        	</td>
					<td>
						<%= message&.body[0...100] %>
					</td>
		        	<td>
		        		<%= link_to "View", nil, class: "link-primary"%>
		        	</td>
		      	</tr>
		   	<% end %>
	  	</tbody>
	  </table>

  </div>
</div>
