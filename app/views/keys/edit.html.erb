<div class="row pb-5 pt-4 pe-3 ps-3 border-bottom border-dark"  >
	<div class="col-6">
		<span class="fs-5 fw-bold">Edit Key</span>
	</div>
	<div class="col-6 ">
	</div>
</div>

<%= simple_form_for @key, url: key_path(@key), method: :put do |f| %>

    <div class="accordion accordion-flush border-bottom border-dark" id="accordionExample">
        <div class="accordion-item">
            <h2 class=" accordionMargin">
            <button disabled class="accordion-button bg-danger collapsed rounded-0"type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                <span class="text-dark fw-bold">Credentials</span>
            </button>
            </h2>
            <div id="collapseOne" class="accordion-collapse show" aria-labelledby="headingOne" data-bs-parent="#accordionExample">

				<table class="table border-1 table-bordered accordionTable">

					<tbody>
						<tr class="border-top-0">
							<td  class="border-start-0 align-middle table-row-height accordionCol1Width">
								<span class="fw-bold " >Key</span>
							</td>
							<td class="align-middle border-end-0">
								<div class="row ">
									<div class="col-1"></div>
									<div class="col-8 ">

										<div class="dropdown d-grid gap-2" >
											<button class="btn btn-secondary dropdown-toggle bg-dark keyValueDropdownLabel" type="button" id="dropdownMenuButton2" data-bs-toggle="dropdown" aria-expanded="false">
													<% if list_of_key_value.include?(@key.key) %>
														<%= @key.key %>
													<% else %>
														Custom Name
													<% end %>
											</button>
											<ul class="dropdown-menu dropdown-menu-dark bg-dark keyValueDropdown" aria-labelledby="dropdownMenuButton2" style="width: 100%;">
												<li><a class="dropdown-item " href="#">ATM PIN</a></li>
												<li><a class="dropdown-item" href="#">SSN</a></li>
												<li><a class="dropdown-item" href="#">MISC PIN Code</a></li>
												<li><a class="dropdown-item" href="#">WIFI Password</a></li>
												<li><hr class="dropdown-divider"></li>
												<li><a class="dropdown-item" href="#">Custom Name</a></li>
											</ul>
										</div>

									</div>
								</div>
								<div class="row pt-3 key-input-field <%= list_of_key_value.include?(@key.key) ? "d-none" : nil %> ">
									<div class="col-1"></div>
									<div class="col-8 ">
									
										<%= f.input :key, wrapper_html: {class: ""}, as: :string, label: false, placeholder: "Anything!" %>
									</div>
								</div>
							</td>
						</tr>
						<tr class="border-top-0">
							<td  class="border-start-0 align-middle table-row-height accordionCol1Width">
								<span class="fw-bold " >Value</span>
							</td>
							<td class="align-middle border-end-0">
								<div class="row ">
								<div class="col-1"></div>
								<div class="col-8 ">
									<%= f.input :value, wrapper_html: {class: ""}, as: :string, label: false, placeholder: "name@example.com" %>
								</div>
								</div>
							</td>
						</tr>
					</tbody>
				</table>
            </div>
        </div>
    </div>
    <div class="row pb-4 pt-5 currentPageColor" >
        <div class="col-2"></div>
        <div class="col-8 ">
            <center>
                <div class="d-grid gap-2">
					<%=f.submit "Update Key",class: "btn btn-danger"%>
                </div>
            </center>
        </div>
        <div class="col-2"></div>
    </div>
<% end %>
