<%= simple_form_for @key, url: keys_path(@key) do |f| %>
	<div class="card border-secondary">
			<div class="card-header bg-white">
					<center>
					<h3>New Key & Value</h3>
					</center>
			</div>
		<div class="card-body">
			<div class="form-group">
				<div class="row">
					<%= f.label "Key:", class: "col-2" %>
					<%= f.input :key, wrapper_html: {class: "col-4"}, as: :string, label: false %>
				</div>
				<br>
				<div class="row">
					<%= f.label "Value:", class: "col-2" %>
					<%= f.input :value, wrapper_html: {class: "col-4"}, as: :string, label: false %>
				</div>
			</div>
		</div>
		<div class="card-footer bg-white pt-3 pb-3 text-center " >
            <%= f.submit "Create Key", class: "btn btn-danger w-75 " %>
        </div>
	</div>
	<br>
<% end %>
