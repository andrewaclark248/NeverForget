<div class="row  pb-3 pt-3 pe-3 ps-3 border-0 border-secondary" >
	<div class="col-6">
		<div>
		<span class="fs-5 fw-bold"><%= @current_user.first %>'s Keys</span>
		</div>
	</div>
	<div class="col-6 ">
		<div class="float-end">
			<%= link_to new_key_path do %>
				<div>
				<button class="btn btn-danger fw-bold">
					<span class="">New Key</span>
				</button>
				</div>
			<% end %>
		</div>
	</div>
</div>

<div class="list-group rounded-0 border-top border-secondary" >
	<%= simple_form_for @key_search, url: user_passwords_path, defaults: { wrapper: false }, method: :post do |f| %>

		<div class="list-group-item border-0" style="background-color: #F8F8F8; " >
			<div class=" pb-3 pt-2" style="display: flex;">
				<div class="" style="margin-right: 20px;">
					<span class="fw-bold">Search Credentials By:</span>
				</div>
				<div class="">
						<div class="input-group-sm">
							<%= f.input :key, label: false, input_html: { type: "radio", class: "btn-check", name: "key-search", id: "key", value: "key"} %>
							<label class="btn btn-outline-primary" for="key">Url's</label>
						
							<%= f.input :value, label: false, input_html: { type: "radio", class: "btn-check", name: "key-search", id: "value", value: "value"} %>
							<label class="btn btn-outline-primary" for="value">Username</label>
						
						</div>
				</div>
			</div>
			<div class="row pb-2">
					<div class="col-8">
						<small>
						<div class="input-group-sm">
							<%= f.input :radio_btn_value, label: false, input_html: {placeholder: "Search"} %>
						</div>
						</small>
					</div>
					<div class="col-4">
						<div class="d-grid gap-2">
							<%= f.submit "Search", class: "btn btn-dark btn-sm" %>
						</div>
					</div>
			</div>
		<% end %>

	</div>


	<div class="list-group-item accordion-bg" >
		<div class="row pb-1 pt-1">
			<div class="col-5">
				<span class="fw-bold ps-3">Key</span>
			</div>
			<div class="col-2">
				<span class="fw-bold">Value</span>
			</div>
			<div class="col-1">
				<span class="fw-bold">Edit</span>
			</div>
			<div class="col-1">
				<span class="fw-bold">Delete</span>
			</div>
		</div>
	</div>

	<% @keys&.each_with_index do |key, index| %>
		<div class="list-group-item border border-1 active-password-table bg-white" style="height: 50px;">
			<div class="row ">
				<div class="col-5">
					<span class="fw-bold ps-3"><%= key.key %></span>
				</div>
				<div class="col-2">
					<span class="fw-bold"><%= key.value %></span>
				</div>
				<div class="col-1">
					<%= link_to edit_key_path(key) do %>
						<button class="btn btn-light bg-dark text-white btn-sm">
							<i class="fa fa-pen-to-square" ></i>
						</button>
					<% end %>
				</div>
				<div class="col-1">
                    <a type="button" name="someDamnName" class="btn btn-danger delete-password btn-sm" data-bs-toggle="modal" data-bs-target="#myModal" value=<%=key.id%>>
                        <i class="fa fa-trash-can text-white"></i>
                    </a> 				
				</div>
			</div>
		</div>
    <% end %>
</div>



