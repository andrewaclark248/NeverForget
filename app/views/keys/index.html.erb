<div class="row  pb-4 pt-4 currentPageColor border-bottom border-dark" >
	<div class="col-6">
		<div style="padding-left: 30px;">
		<span class="fs-5 fw-bold"><%= @current_user.first %>'s Keys</span>
		</div>
	</div>
	<div class="col-6 ">
		<div class="float-end">
			<%= link_to new_key_path do %>
				<div style="padding-right: 50px;">
				<button class="btn btn-danger ">
					<i class="fa-solid fa-plus pe-2 text-dark"></i><span class="text-dark fw-bold">New Key</span>
				</button>
				</div>
			<% end %>
		</div>
	</div>
</div>


<div class="list-group rounded-0 border-bottom border-dark">

	<div class="list-group-item bg-danger ">
		<div class="row pb-1 pt-1">
			<div class="col-3">
				<span class="fw-bold ps-3">Key</span>
			</div>
			<div class="col-7">
				<span class="fw-bold">Value</span>
			</div>
			<div class="col-1">
				<span class="fw-bold">Edit</span>
			</div>
			<div class="col-1">
				<span class="fw-bold">Delete</span>
			</div>
		</div>
	</div>

	<% @keys&.each_with_index do |key, index| %>
		<div class="list-group-item border border-1 active-password-table bg-white">
			<div class="row pb-1 pt-1">
				<div class="col-3">
					<span class="fw-bold ps-3"><%= key.key %></span>
				</div>
				<div class="col-7">
					<span class="fw-bold"><%= key.value %></span>
				</div>
				<div class="col-1">
					<%= link_to edit_key_path(key) do %>
						<button class="btn btn-light">
							<i class="fa fa-pen-to-square"></i>
							Edit
						</button>
					<% end %>
				</div>
				<div class="col-1">
					<a type="button" name="someDamnName" class="btn btn-danger delete-key-value" data-bs-toggle="modal" data-bs-target="#myModal" value=<%=key.id%>   >                
						<i class="fa fa-trash-can text-dark"></i>
					</a> 				
				</div>
			</div>
		</div>
    <% end %>
</div>


<%= render "delete_key_modal" %>


