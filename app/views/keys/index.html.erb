<div class="row">
	<div class="col-6">
		<h3><%= @current_user.first %>'s Keys</h3>
	</div>
	<div class="col-6 ">
		<div class="float-end">
			<%= link_to "Create Key & Value", new_key_path,class: "btn btn-danger btn-lg"%>
		</div>
	</div>
</div>
<br>
<br>

<div class="card border-secondary">
  <div class="card-body">
	  <table class="table table-striped">
	    <thead>
	      <tr>
	        <th>Key</th>
			<th>Value</th>
	        <th>Edit</th>
			<th>Delete</th>
	      </tr>
	    </thead>
	    <tbody>
		    <% @keys&.each do |key| %>
		    	<tr>
					<td>
		        		<%= key.key %>
		        	</td>
					<td>
		        		<%= key.value %>
		        	</td>
		        	<td>
		        		<%= link_to "Edit", edit_key_path(key), class: "link-primary"%>
		        	</td>
					<td>
						<a type="button" class="link-primary delete-key-value text-danger" data-bs-toggle="modal" data-bs-target="#myModal" value=<%=key.id%>>
							Delete
						</a>		        	
					</td>
		      	</tr>
		   	<% end %>
	  	</tbody>
	  </table>

  </div>
</div>

<div class="modal fade" id="myModal">
  <div class="modal-dialog">
    <div class="modal-content">

      <!-- Modal Header -->
      <div class="modal-header bg-light">
        <h4 class="modal-title">Delete Key</h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <!-- Modal body -->
      <div class="modal-body bg-light">
	  	<div class="row pb-3">
		  	<div class="col-12">
        		Are you sure you want to delete the following <span class="fw-bold">Key</span>?
			</div>
		</div>
		<div class="row pb-2">
			<div class="col-2">
				<span>Key: </span>
			</div>
			<div class="col-9">
				<strong><span class="current-key text-danger"></span></strong>
			</div>
		</div>
		<div class="row">
			<div class="col-2">
				<span>Value: </span>
			</div>
			<div class="col-9">
				<strong><span class="current-value text-danger"></span></strong>
			</div>
		</div>
		<br>
      </div>

      <!-- Modal footer -->
      <div class="modal-footer">
	  		<div class="row w-100">
			  	<div class="col-6">
					<%= link_to "Yes", key_path(12), method: :delete, class: "btn btn-danger btn-lg btn-block w-100 delete-key-value-accept",:data => { "data-bs-dismiss": "modal"} %>
			    </div>
				<div class="col-6">
					<button type="button" class="btn btn-primary btn-lg btn-block w-100" data-bs-dismiss="modal">No</button>
				</div>
			</div>

	  </div>

    </div>
  </div>
</div>

