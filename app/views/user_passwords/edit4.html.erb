<div class="row pb-5 pt-4 pe-3 ps-3" >
	<div class="col-6">
		<span class="fs-5 fw-bold">Edit Password</span>
	</div>
	<div class="col-6 ">
	</div>
</div>

<%= simple_form_for @password, url: user_password_path(@password), method: :put do |f| %>

    <div class="accordion accordion-flush border-bottom border-secondary" id="accordionExample">
        <div class="accordion-item ">
            <h2 class=" accordionMargin" >
            <button class="accordion-button accordion-bg collapsed pt-4 pb-4" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                <span class="text-dark fw-bold">Password Credentials</span>
            </button>
            </h2>
            <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#accordionExample">
                <%= render "credentials_form", f: f, password: @password %>
            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingTwo">
            <button class="accordion-button collapsed accordion-bg  pt-4 pb-4 " type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                <span class="fw-bold text-dark">Password Security Options</span>
            </button>
            </h2>
            <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#accordionExample">
                <%= render "security_form", f: f, password: @password %>
            </div>
        </div>
        <div class="accordion-item border-bottom-0 ">
            <h2 class="accordion-header" id="headingThree">
            <button class="accordion-button collapsed rounded-0 accordion-bg pt-4 pb-4 " type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                <span class="fw-bold text-dark">Other</span>
            </button>
            </h2>
            <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#accordionExample">
                <%= render "other_form", f: f, password: @password %>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12 ">
            <center>
                <div class="d-grid gap-2">
					<%=f.submit "Update Password",class: "btn btn-danger rounded-0 btn-lg", style: 'height: 70px' %>
                </div>
            </center>
        </div>
    </div>
<% end %>


<%= render "share_via_email_modal", password: @password %>