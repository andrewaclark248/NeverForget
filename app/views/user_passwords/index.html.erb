<div class="row  mb-4 mt-4">
	<div class="col-6">
		<div style="padding-left: 30px;">
		<span class="fs-5 fw-bold"><%= @current_user.first %>'s Passwords</span>
		</div>
	</div>
	<div class="col-6 ">
		<div class="float-end">
			<%= link_to new_user_password_path do %>
				<div style="padding-right: 50px;">
				<button class="btn btn-danger ">
					<i class="fa-solid fa-plus pe-2 text-dark"></i><span class="text-dark fw-bold">New Password</span>
				</button>
				</div>
			<% end %>
		</div>
	</div>
</div>


<div class="list-group rounded-0 ">

	<div class="list-group-item bg-danger ">
		<div class="row pb-1 pt-1">
			<div class="col-5">
				<span class="fw-bold ps-3">Username</span>
			</div>
			<div class="col-5">
				<span class="fw-bold">URL's</span>
			</div>
			<div class="col-1">
				<span class="fw-bold">Edit</span>
			</div>
			<div class="col-1">
				<span class="fw-bold">Delete</span>
			</div>
		</div>
	</div>

	<% @passwords&.each_with_index do |password, index| %>
		<div class="list-group-item border border-1 active-password-table bg-white">
			<div class="row pb-1 pt-1">
				<div class="col-5">
					<span class="fw-bold ps-3"><%= password.username %></span>
				</div>
				<div class="col-5">
					<span class="fw-bold"><%= password.urls.pluck(:name).join(", ") %></span>
				</div>
				<div class="col-1">
					<%= link_to edit_user_password_path(password) do %>
						<button class="btn btn-light">
							<i class="fa fa-pen-to-square"></i>
							Edit
						</button>
					<% end %>
				</div>
				<div class="col-1">
                    <a type="button" name="someDamnName" class="btn btn-danger delete-password" data-bs-toggle="modal" data-bs-target="#myModal" value=<%=password.id%>>
                        <i class="fa fa-trash-can text-dark"></i>
                    </a> 				
				</div>
			</div>
		</div>
    <% end %>
</div>


<div class="modal fade " id="myModal">
  <div class="modal-dialog">
    <div class="modal-content">

      <!-- Modal Header -->
      <div class="modal-header bg-dark">
			<span class=""><h4 class="modal-title text-white">Delete Password</h4></span>
		  	<button type="button" class="btn-close " data-bs-dismiss="modal"></button>
      </div>

      <!-- Modal body -->
      <div class="modal-body bg-white">
	  	<div class="row pb-3">
			<span class="text-dark">
				Are you sure you want to <span class="text-danger">delete</span> the following Username & Password?
			</span>
		</div>


		<center>
		<table class="table table-bordered bg-light w-75 ">
			<tbody >
			<tr >
				<td class="fw-bold" style="width: 35%;" >
					<center>
						Username
					</center>

				</td>
				<td>
					<center>
					<span class="current-username text-danger"></span>
					</center>
				</td>
			</tr>
			<tr>
				<td class="fw-bold">
					<center>
						Password
					<center>
				</td>
				<td>
					<center>
					<span class="current-password text-danger"></span>
					</center>
				</td>
			</tr>
			</tbody>
		</table>
		</center>

      </div>

      <!-- Modal footer -->
      <div class="modal-footer bg-light">
	  		<div class="row w-100">
			  	<div class="col-6">
					<%= link_to "Yes", user_password_path(12), method: :delete, class: "btn btn-danger btn-lg btn-block w-100 delete-password-accept",:data => { "data-bs-dismiss": "modal"} %>
			    </div>
				<div class="col-6">
					<button type="button" class="btn btn-primary btn-lg btn-block w-100" data-bs-dismiss="modal">No</button>
				</div>
			</div>
	  </div>
    </div>
  </div>
</div>

