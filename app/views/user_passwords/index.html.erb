
<center>
	<div class="d-grid gap-2">
		<%= link_to "Create Password", new_user_password_path,class: "btn btn-danger btn-lg"%>
	</div>
</center>

<br>
<br>

<div class="card">
  <div class="card-header">
    <h3>Your Passwords</h3>
  </div>
  <div class="card-body">

	  <table class="table table-striped">
	    <thead>
	      <tr>
	        <th>Username</th>
			<th>URL's</th>
	        <th>Password</th>
	        <th>Edit</th>
	      </tr>
	    </thead>
	    <tbody>
		    <% @passwords&.each do |password| %>
		    	<tr>
					<td>
		        		<%= password.username %>
		        	</td>
					<td>
		        		<%= password.urls.pluck(:name).join(", ") %>
		        	</td>
		        	<td>
		        		<%= password.password ? "Encrypted" : "NONE" %>
		        	</td>
		        	<td>
		        		<%= link_to "Edit", edit_user_password_path(password), class: "link-primary"%>
		        	</td>
		      	</tr>
		   	<% end %>
	  	</tbody>
	  </table>

  </div>
</div>