
<center>
	<%= link_to "Create Password", new_user_password_path,class: "btn btn-danger"%>
</center>
<br>
<br>

<div class="card">
  <div class="card-header">
    <h3>Your Passwords</h3>
  </div>
  <div class="card-body">

	  <table class="table table-striped">
	    <thead>
	      <tr>
	        <th>Password</th>
	        <th>Unencrypte Password</th>
	        <th>Edit</th>
	      </tr>
	    </thead>
	    <tbody>
		    <% @passwords&.each do |password| %>
		    	<tr>
		        	<td>
		        		<%= password.encrypted_password.squish.truncate(26) %>
		        			
		        	</td>
		        	<td>
		        		<%= password.password %>
		        	</td>
		        	<td>
		        		<%= link_to "Edit", edit_user_password_path(password), class: "link-primary"%>
		        	</td>
		      	</tr>
		   	<% end %>
	  	</tbody>
	  </table>

  </div>
</div>