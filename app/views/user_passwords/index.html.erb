<div class="row pb-5 ps-4 pe-4">
	<div class="col-6">
		<span class="fs-4 fw-bold"><%= @current_user.first %>'s Passwords</span>
	</div>
	<div class="col-6 ">
		<div class="float-end">
			<%= link_to "Create New Password", new_user_password_path,class: "btn btn-danger "%>
		</div>
	</div>
</div>


<div class="list-group rounded-0 ">

	<div class="list-group-item bg-danger">
		<div class="row">
			<div class="col-4">
				<span class="fw-bold">Username</span>
			</div>
			<div class="col-4">
				<span class="fw-bold">URL's</span>
			</div>
			<div class="col-2">
				<span class="fw-bold">Edit</span>
			</div>
			<div class="col-2">
				<span class="fw-bold">Delete</span>
			</div>
		</div>
	</div>

	<% @passwords&.each do |password| %>
		<div class="list-group-item bg-light border border-secondary border-1 active-password-table">
			<div class="row">
				<div class="col-4">
					<span class="fw-bold"><%= password.username %></span>
				</div>
				<div class="col-4">
					<span class="fw-bold"><%= password.urls.pluck(:name).join(", ") %></span>
				</div>
				<div class="col-2">
					<%= link_to "Edit", edit_user_password_path(password), class: "link-primary"%>
				</div>
				<div class="col-2">
                    <a type="button" name="someDamnName" class="link-danger delete-password" data-bs-toggle="modal" data-bs-target="#myModal" value=<%=password.id%>>
                        Delete
                    </a> 				
				</div>
			</div>
		</div>
    <% end %>
</div>


<div class="modal fade " id="myModal">
  <div class="modal-dialog">
    <div class="modal-content">

      <!-- Modal Header -->
      <div class="modal-header bg-dark">
			<span class=""><h4 class="modal-title text-white">Delete Password</h4></span>
		  	<button type="button" class="btn-close " data-bs-dismiss="modal"></button>
      </div>

      <!-- Modal body -->
      <div class="modal-body bg-white">
	  	<div class="row pb-3">
			<span class="text-dark">
				Are you sure you want to <span class="text-danger">delete</span> the following Username & Password?
			</span>
		</div>


		<center>
		<table class="table table-bordered bg-light w-75 ">
			<tbody >
			<tr >
				<td class="fw-bold" style="width: 35%;" >
					<center>
						Username
					</center>

				</td>
				<td>
					<center>
					<span class="current-username text-danger"></span>
					</center>
				</td>
			</tr>
			<tr>
				<td class="fw-bold">
					<center>
						Password
					<center>
				</td>
				<td>
					<center>
					<span class="current-password text-danger"></span>
					</center>
				</td>
			</tr>
			</tbody>
		</table>
		</center>

      </div>

      <!-- Modal footer -->
      <div class="modal-footer bg-light">
	  		<div class="row w-100">
			  	<div class="col-6">
					<%= link_to "Yes", user_password_path(12), method: :delete, class: "btn btn-danger btn-lg btn-block w-100 delete-password-accept",:data => { "data-bs-dismiss": "modal"} %>
			    </div>
				<div class="col-6">
					<button type="button" class="btn btn-primary btn-lg btn-block w-100" data-bs-dismiss="modal">No</button>
				</div>
			</div>

	  </div>

    </div>
  </div>
</div>

