<table class="table border-1 table-bordered accordionTable">

    <tbody>
      <tr class="border-top-0 bg-white">
        <td  class="border-start-0 align-middle table-row-height accordionCol1Width">
			<span class="fw-bold " >Manually Rotate Your Password</span>
            <i class="ps-2 fa-solid fa fa-info-circle fa-lg " data-bs-toggle="tooltip" title="<%=@last_updated_at_text%>" ></i>
		</td>
        <td class="align-middle border-end-0">
			<div class="row ">
				<div class="col-1"></div>
				<div class="col-8 ">
                    <button type="button" class="btn btn-dark manually-rotate-password" data-bs-toggle="modal" data-bs-target="#myModal">
                        Rotate Password
                    </button>
    			</div>
			</div>
		</td>
      </tr>
	  <tr >
        <td  class="border-start-0 align-middle table-row-height accordionCol1Width">
			<span class="fw-bold">Password Last Updated At</span>
            <i class="ps-2 fa-solid fa fa-info-circle fa-lg" data-bs-toggle="tooltip" title="<%=@last_updated_at_text%>" ></i>

		</td>
        <td class="align-middle border-end-0">
			<div class="row ">
				<div class="col-1"></div>
				<div class="col-8 ">
                    <span class="text-danger fw-bold"><%= password.updated_at.strftime("%B %d, %Y") %>
				</div>
			</div>
		</td>
      </tr>
	  <tr>
        <td  class="border-start-0 align-middle table-row-height accordionCol1Width" >
			<span class="fw-bold">Auto Rotate Password</span>
            <i class="ps-2 fa-solid fa fa-info-circle fa-lg" data-bs-toggle="tooltip" title="<%=@last_updated_at_text%>" ></i>

		</td>
        <td class="align-middle border-end-0">
			<div class="row ">
				<div class="col-1"></div>
				<div class="col-11 ">

                <div class="btn-group" role="group" aria-label="Basic checkbox toggle button group" >
                    <input type="checkbox" class="btn-check" id="btncheck1" autocomplete="off">
                    <label class="btn btn-outline-danger" for="btncheck1">1 Month</label>

                    <input type="checkbox" class="btn-check" id="btncheck2" autocomplete="off">
                    <label class="btn btn-outline-danger" for="btncheck2">3 months</label>

                    <input type="checkbox" class="btn-check" id="btncheck3" autocomplete="off">
                    <label class="btn btn-outline-danger" for="btncheck3">6 Months</label>
                

                    <input type="checkbox" class="btn-check" id="btncheck3" autocomplete="off">
                    <label class="btn btn-outline-danger" for="btncheck3">1 Year</label>
                </div>


				</div>
			</div>
		</td>
      </tr>
    </tbody>
  </table>


  <%= render "manual_rotate" %>