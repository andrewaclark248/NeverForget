

<h3 class="text-white">Edit Password</h3>
<br>
<br>
<div class="card">
  <div class="card-body">

	<%= simple_form_for @password, url: user_password_path(@password), method: :put do |password| %>
		<center>
			<div class="d-grid gap-2">
				<%= password.button :submit, class: "btn btn-danger btn-lg" %>
			</div>
		</center>
		<br>
		<p>
			<strong>*Add a url that matches the following pattern: domain.com</strong><br>
			<span>Example: google.com</span>
		</p>
		<br>
		<div class="form-group">
			<div class="row">
				<%= password.label "Username:", class: "col-2" %>
				<%= password.input :username, wrapper_html: {class: "col-4"}, as: :string, label: false %>
			</div>
			<br>
			<div class="row">
				<%= password.label "Password:", class: "col-2" %>
				<%= password.input :password, wrapper_html: {class: "col-4"}, as: :string, label: false %>
				<div class="col-4 ps-4">
					<button type="button" class="btn btn-warning manually-rotate-password" data-bs-toggle="modal" data-bs-target="#myModal">
						Manually Rotate Password
					</button>
  					<i class="fa-solid fa fa-info-circle fa-lg" data-bs-toggle="tooltip" title="<%=@rotate_password_text%>" ></i>
				</div>
			</div>

	  		<br>
	  		<br>
			<span><strong>Add Associated URL's</strong></span>
			<br>
			<br>
			<%= password.simple_fields_for :urls do |u| %>
			    <%= render "url_fields", f: u %>
			<% end %>
			<br>
			<div class="links form-actions">
				<%= link_to_add_association "Add URL", password, :urls, class: "btn btn-danger" %>
			</div>
	  		<br>


		</div>
	<% end %>
  </div>
</div>

<div class="modal fade" id="myModal">
  <div class="modal-dialog">
    <div class="modal-content">

      <!-- Modal Header -->
      <div class="modal-header">
        <h4 class="modal-title">Password Generation</h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <!-- Modal body -->
      <div class="modal-body">
        Suggested Password:
		<strong><span class="new-password text-danger"></span></strong>
		<br>
		<br>
		<span class="text-warning">Generated password has been added to form. Just click the 'Update Password' button!</span>
      </div>

      <!-- Modal footer -->
      <div class="modal-footer">
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
      </div>

    </div>
  </div>
</div>
