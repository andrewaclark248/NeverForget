<div class="tab-pane fade show active" id="home">
    <div class="row pb-3">
        <div class="col-6 ">
            <%= f.label "Username", class: "text-secondary" %>
            <div class="d-flex">
                <div class=" flex-grow-1">
                    <%= f.input :username, wrapper_html: {class: "w-auto"}, as: :string, label: false %>
                </div>
                <div class="pt-1 ps-2">
                    <button type="button" class="bg-white copy-username-icon  btn btn-secondary" style="border: none">
                        <i class="fa fa-clone text-dark username-copy-icon" data-bs-toggle="tooltip" title="Copied Username!" ></i>
                    </button>
                </div>
            </div>
        </div><!-- rounded border border-dark -->
        <div class="col-6">
            <%= f.label "Password", class: "text-secondary" %>
            <div class="d-flex">
                <div class="flex-grow-1">
                    <%= f.input :password, wrapper_html: {class: "pb-3"}, as: :string, label: false %>
                </div>
                <div class="pt-1 ps-2">
                   <button type="button" class="bg-white copy-password-icon btn btn-secondary" style="border: none">
                        <i class="fa fa-clone text-dark password-copy-icon" data-bs-toggle="tooltip" title="Copied Password!" ></i>
                    </button>
                 </div>
            </div>
            <%= render "password_strength" %>
        </div>
    </div>
    <hr>
    <div class="row">
        <%= f.simple_fields_for :urls do |u| %>
            <%= render "url_fields", f: u %>
        <% end %>
        <div class="links form-actions">
            <%= link_to_add_association "Add URL", f, :urls, class: "btn btn-danger" %>
        </div>
    </div>
</div>
