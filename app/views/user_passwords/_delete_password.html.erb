<div class="modal fade " id="myModal">
  <div class="modal-dialog">
    <div class="modal-content">

      <!-- Modal Header -->
      <div class="modal-header bg-danger">
			<span class=""><h4 class="modal-title text-dark">Delete Password</h4></span>
		  	<button type="button" class="btn-close " data-bs-dismiss="modal"></button>
      </div>

      <!-- Modal body -->
        <div class="modal-body bg-white">
            <div class="row pb-3">
                <span class="text-dark">
                    Are you sure you want to <span class="text-danger fw-bold">delete</span> the following Username & Password?
                </span>
            </div>
        

        <div class="row active-tab">
            <div class="col-3">
                <span>Username:</span>
            </div>
            <div class="col-6">
                <span class="current-username text-danger fw-bold"></span>
            </div>
        </div>
        <div class="row active-tab">
            <div class="col-3">
                <span>Password:</span>
            </div>
            <div class="col-6">
                <span class="current-password text-danger fw-bold"></span>
            </div>
        </div>

        
        </div>

      <!-- Modal footer -->
      <div class="modal-footer bg-white">
	  		<div class="row w-100">
			  	<div class="col-6">
					<%= link_to "Yes", user_password_path(12), method: :delete, class: "btn btn-danger btn-lg btn-block w-100 delete-password-accept",:data => { "data-bs-dismiss": "modal"} %>
			    </div>
				<div class="col-6">
					<button type="button" class="btn btn-primary btn-lg btn-block w-100" data-bs-dismiss="modal">No</button>
				</div>
			</div>
	  </div>
    </div>
  </div>
</div>

