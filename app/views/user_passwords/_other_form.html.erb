<table class="table border-1 table-bordered accordionTable" >
    <tbody>
        <tr class="border-top-0" >
            <td  class="border-start-0 align-middle table-row-height accordionCol1Width">
                <span class="fw-bold " >Share Your Password With a Contact</span>
                <i class="ps-2 fa-solid fa fa-info-circle fa-lg" data-bs-toggle="tooltip" title="<%=@last_updated_at_text%>" ></i>
            </td>
            <td class="align-middle border-end-0">
                <div class="row ">
                    <div class="col-1"></div>
                    <div class="col-8 ">
                        <button type="button" class="btn btn-dark " data-bs-toggle="modal" data-bs-target="#sharePasswordWithContact">
                            Share Your Password Via Phone
                        </button>
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            <td  class="border-start-0 align-middle table-row-height accordionCol1Width">
                <span class="fw-bold " >Share Your Password With a Contact</span>
            </td>
            <td class="align-middle border-end-0">
                <div class="row ">
                    <div class="col-1"></div>
                    <div class="col-8 ">
                    	<a type="button" name="someDamnName" class="btn btn-dark text-white" data-bs-toggle="modal" data-bs-target="#sharePasswordViaEmail" >                
                            Send Credentials Via Email
                        </a> 
                    </div>
                </div>
            </td>
        </tr>
    </tbody>
</table>

<%= render "share_password_modal", f: f, password: @password %>
