<div class=" ">

  <table class="table border-1 table-bordered" style="margin-bottom: 0rem; ">

    <tbody>
      <tr class="border-top-0">
        <td  class="border-start-0 align-middle table-row-height" style="width:30%">
          <span class="fw-bold " >Username</span>
        </td>
        <td class="align-middle border-end-0">
          <div class="row ">
            <div class="col-1"></div>
            <div class="col-8 ">
              <%= f.input :username, wrapper_html: {class: ""}, as: :string, label: false, placeholder: "name@example.com" %>
            </div>
          </div>
        </td>
      </tr>
      <tr style="background: #F1F2F1;">
          <td class="border-start-0 align-middle table-row-height" style="width:30%">
            <span class="fw-bold">Password</span>
          </td>
          <td class="align-middle border-end-0">
            <div class="row ">
              <div class="col-1"></div>
              <div class="col-8 ">
                <div class="pb-2">
                  <%= f.input :password, wrapper_html: {class: ""}, as: :string, label: false %>
                  <%= f.hidden_field :pwd_strength, :value => "" %>
                </div>
                <div class="password-strength-text">
                  <span class="pe-2 text-secondary">Password Strength:</span><span class="password-strength-status-text text-danger">POOR</span>
                </div>
                <div class="password-strength-analyzer">
                  <div class="card cardPwd" >
                    <div class="card-body">
                      <%= render "password_strength_v2" %>
                    </div>
                  </div>
                </div>	
              </div>
            </div>
          </td>
        </tr>
        <tr class=""> 
          <td class="border-start-0 table-row-height">
              <div class="pt-2">
                <span class="fw-bold ">URL's</span>
              </div>
          </td>
          <td class="border-end-0">
              <div class="pt-2 pb-2">
                  <%= f.simple_fields_for :urls do |u| %>
                      <%= render "url_fields", f: u %>
                  <% end %>
                  <div class="row">
                          <div class="links form-actions" style="padding-left: 10%;">
                              <%= link_to_add_association "Add URL", f, :urls, class: "btn btn-danger rounded-pill text-dark" %>
                          </div>
                  </div>
              </div>
          </td>
        </tr>
    </tbody>
  </table>

</div>