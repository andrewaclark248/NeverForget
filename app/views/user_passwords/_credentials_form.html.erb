<div class=" ">

  <table class="table border-1 table-bordered bg-white" style="margin-bottom: 0rem; ">

    <tbody>
      <tr class="border-top-0">
        <td  class="border-start-0 align-middle table-row-height" style="width:30%">
          <span class="fw-bold " >Username</span>
        </td>
        <td class="align-middle border-end-0">
          <div class="row ">
            <div class="col-1"></div>
            <div class="col-8 ">
              <%= f.input :username, wrapper_html: {class: ""}, as: :string, label: false, placeholder: "name@example.com" %>
            </div>
          </div>
        </td>
      </tr>
      <tr >
          <td class="border-start-0 align-middle table-row-height" style="width:30%">
            <span class="fw-bold">Password</span>
          </td>
          <td class="align-middle border-end-0">
            <div class="row">
              <div class="col-1"></div>
              <div class="col-8 ">
                <div class="pb-3">
                  <i class="fa-solid fa-eye errspan eyeIconCursor text-dark"></i>
                  <%= f.input :password, as: :string, label: false, input_html: {type: "password"} %>
                  <%= f.hidden_field :pwd_strength, :value => "" %>
                </div>
                <div class="password-strength-text">
                  <% if password.pwd_strength %>
                    <span class="pe-2 text-secondary">Password Strength:</span>
                    <span class="password-strength-status-text badge <%= get_pwd_color(password.pwd_strength) %>"><%= password.pwd_strength&.upcase %></span>
                  <% end %>
                </div>
                <div class="password-strength-analyzer">
                  <div class="card cardPwd bg-light" >
                    <div class="card-body">
                      <%= render "password_strength_v2" %>
                    </div>
                  </div>
                </div>	
              </div>
              <div class="col-1 copyPassword">
                <button type="button" class="btn copyIcon" data-clipboard-target="#password_password"  data-bs-toggle="tooltip" data-bs-placement="top" title="Copy Password">
                      <%= image_tag "clipboard" %>
                </button>
              </div>
            </div>
          </td>
        </tr>
        <tr class=""> 
          <td class="border-start-0 table-row-height">
              <div class="pt-2">
                <span class="fw-bold ">URL's</span>
              </div>
          </td>
          <td class="border-end-0">
              <div class="pt-2 pb-2">
                  <%= f.simple_fields_for :urls do |u| %>
                      <%= render "url_fields", f: u %>
                  <% end %>
                  <div class="row">
                          <div class="links form-actions" style="padding-left: 10%;">
                              <%= link_to_add_association add_url_btn, f, :urls, class: "btn btn-danger rounded-pill text-dark" %>
                          </div>
                  </div>
              </div>
          </td>
        </tr>
    </tbody>
  </table>

</div>