<div class="row">
	<div class="col-6">
	</div>
	<div class="col-6 ">

	</div>
</div>
<div class="row">
<div class="col-1"></div>
<div class="col-10">
<%= simple_form_for @password, url: user_passwords_path(@password) do |password| %>
	<div class="card border-secondary ">
		<div class="card-header border-bottom-0 bg-white" >
				<center>
				<h3 class="text-dark">New Password</h3>
				</center>
		</div>

			<div class="form-group">

  <table class="table border-1 table-bordered " style=" margin-bottom: 0rem; ">

    <tbody>
      <tr class="" >
        <td  class="border-start-0 align-middle table-row-height" style="width:30%">
			<span class="fw-bold " >Username</span>
		</td>
        <td class="align-middle border-end-0">
			<div class="row ">
				<div class="col-1"></div>
				<div class="col-8 ">
					<%= password.input :username, wrapper_html: {class: ""}, as: :string, label: false, placeholder: "name@example.com" %>
				</div>
			</div>
		</td>
      </tr>
	  <tr style="background: #F1F2F1;">
        <td  class="border-start-0 align-middle table-row-height" style="width:30%">
			<span class="fw-bold " >Password</span>
		</td>
        <td class="align-middle border-end-0">
			<div class="row ">
				<div class="col-1"></div>
				<div class="col-8 ">
					<%= password.input :password, wrapper_html: {class: ""}, as: :string, label: false %>
				</div>
			</div>
		</td>
      </tr>
      <tr class="table-row-height" > 
        <td class="border-start-0">
			<span class="fw-bold">URL's</span>
		</td>
        <td class="border-end-0">
			<%= password.simple_fields_for :urls do |u| %>
				<%= render "url_fields", f: u %>
			<% end %>
			<div class="row">
				<div class="col-1"></div>
					<div class="links form-actions" style="padding-left: 10%;">
						<%= link_to_add_association "Add URL", password, :urls, class: "btn btn-danger rounded-pill" %>
					</div>
			</div>
		</td>
      </tr>
    </tbody>
  </table>




			</div>
		<div class="card-footer bg-light pt-4 pb-4 text-center border-top-0" style="" >
            <%= password.submit "Create Password", class: "btn btn-danger w-75 " %>
        </div>
	</div>
<% end %>
</div>
<div class="col-1"></div>
</div>