<div class="row ps-3 pe-3 pb-4 pt-4 currentPageColor border-bottom border-dark">
	<div class="col-6">
		<span class="fs-5 fw-bold">New Password</span>
	</div>
	<div class="col-6 ">
	</div>
</div>

<%= simple_form_for @password, url: user_passwords_path(@password) do |f| %>

    <div class="accordion accordion-flush border-bottom border-dark" id="accordionExample">
        <div class="accordion-item">
            <h2 class=" " id=""  style="margin-bottom: 0px;">
            <button disabled class="accordion-button bg-danger collapsed rounded-0"  style="	" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                <span class="text-dark fw-bold">Credentials</span>
            </button>
            </h2>
            <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#accordionExample">
                <%= render "credentials_form", f: f %>
            </div>
        </div>
    </div>
    <div class="row currentPageColor pb-4 pt-5" >
        <div class="col-2"></div>
        <div class="col-8 ">
            <center>
                <div class="d-grid gap-2">
					<%=f.submit "Update Password",class: "btn btn-danger"%>
                </div>
            </center>
        </div>
        <div class="col-2"></div>
    </div>
<% end %>
