<div class="row">
	<div class="col-6">
	</div>
	<div class="col-6 ">

	</div>
</div>
<div class="row">
<div class="col-1"></div>
<div class="col-10">
<%= simple_form_for @password, url: user_passwords_path(@password) do |password| %>
	<div class="card border-secondary ">
		<div class="card-header bg-white">
				<center>
				<h3>New Password</h3>
				</center>
		</div>

		<div class="card-body">
			<div class="form-group">
				<span><strong>*Add Your Credentials</strong></span>
				<br>
				<br>
				<div class="row">
					<%= password.label "Username"%>
					<%= password.input :username, wrapper_html: {class: "col-4"}, as: :string, label: false %>
				</div>
				<br>
				<div class="row">
					<%= password.label "Password" %>
					<%= password.input :password, wrapper_html: {class: "col-4 password-strength-input"}, as: :string, label: false %>
					<div class="col-8">

							<div class="password-strength-analyzer">
								<div class="card bg-light mb-3">
									<div class="card-body">

										<div class="row pb-2">
											<div class="col-1">
											</div>
											<div class="col-10">
												<span class="pe-2"><strong>Password Strength:</strong> </span><span class="password-strength-status-text text-danger fw-bold fs-5">POOR</span>
											</div>
											<div class="col-1">
											</div>
										</div>
										<div class="row pb-3">
											<div class="col-1">
											</div>
											<div class="col-6">
												<div class="progress">
													<div class="progress-bar bg-danger password-strength-status-bar width-quarter" role="progressbar" style="" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100"></div>
												</div>
											</div>
										</div>
										<div class="row">
											<div class="col-1">
											</div>
											<div class="col-10">
												<ul style="list-style: none">
													<li> 
														<div class="row">
															<div class="col-1">
																<i class="has12CharIcon fa fa-check-square" aria-hidden="true"></i>
															</div>
															<div class="col-11">
																<span class="has12Char text-danger">At least 12 characters</span>
															</div>
													</li>
													<li>		
														<div class="row">
															<div class="col-1">
																<i class="hasUpperAndLowerIcon fa fa-check-square" aria-hidden="true"></i>
															</div>
															<div class="col-11">
																<span class="hasUpperAndLower text-danger">A mixture of both uppercase and lowercase letters</span>
															</div>
														</div>											
													</li>
													<li>
														<div class="row">
															<div class="col-1">
																<i class="hasLetterAndNumbersIcon fa fa-check-square" aria-hidden="true"></i>
															</div>
															<div class="col-11">
																<span class="hasLetterAndNumbers text-danger" >Both letters and numbers</span>
															</div>
														</div>
													</li>
													<li>	
														<div class="row">
															<div class="col-1">
																<i class="hasSpecialCharIcon fa fa-check-square" aria-hidden="true"></i>
															</div>
															<div class="col-11">
																<span class="hasSpecialChar text-danger">Inclusion of at least one special character</span>
															</div>
														</div>												
													</li>
												</ul>  
											</div>
										</div>
										
									</div>
								</div>
							</div>


					</div>
				</div>
				<br>
				<hr>
				<span><strong>*Add Associated URL's</strong></span>
				<br>
				<br>
				<%= password.simple_fields_for :urls do |u| %>
					<%= render "url_fields", f: u %>
				<% end %>
				<div class="links">
					<%= link_to_add_association "Add URL", password, :urls, class: "btn btn-danger" %>
				</div>
				<br>
			</div>
		</div>
		<div class="card-footer bg-white pt-3 pb-3 text-center " >
            <%= password.submit "Create Password", class: "btn btn-danger w-75 " %>
        </div>
	</div>
<% end %>
</div>
<div class="col-1"></div>
</div>