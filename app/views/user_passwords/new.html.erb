<h3 class="text-white">New Password</h3>
<br>
<br>
<div class="card">
  <div class="card-body">

	<%= simple_form_for @password, url: user_passwords_path(@password) do |password| %>
		<center>
			<div class="d-grid gap-2">
				<%= password.button :submit, class: "btn btn-danger btn-lg" %>
			</div>
		</center>
		<br>
		<p>
			<strong>*Add a url that matches the following pattern: domain.com</strong><br>
			<span>Example: google.com</span>
		</p>
		<br>
		<div class="form-group">
			<div class="row">
				<%= password.label "Username:", class: "col-2" %>
				<%= password.input :username, wrapper_html: {class: "col-4"}, as: :string, label: false %>
			</div>
			<br>
			<div class="row">
				<%= password.label "Password:", class: "col-2" %>
				<%= password.input :password, wrapper_html: {class: "col-4 password-strength-input"}, as: :string, label: false %>
				<div class="col-6">
					<div class="row">
						<div class="col-2">
						</div>
						<div class="col-10">
							<span>Password Strength: GOOD!</span>
						</div>
					</div>
					<div class="password-strength-analyzer">
						<div class="row">
							<div class="col-2">
							</div>
							<div class="col-6">
								<div class="progress">
									<div class="progress-bar bg-danger password-strength-status-bar" role="progressbar" style="width: 25%" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100"></div>
								</div>
							</div>
						</div>
						<br>
						<div class="row">
							<div class="col-2">
							</div>
							<div class="col-10">
								<span>Attributes of Strong Passwords</span>
								<ul>
									<li><span class="has12Char text-danger">At least 12 characters</span></li>
									<li><span class="hasUpperAndLower text-danger">A mixture of both uppercase and lowercase letters</span></li>
									<li><span class="hasLetterAndNumbers text-danger" >Both letters and numbers</span></li>
									<li><span class="hasSpecialChar text-danger">Inclusion of at least one special character</span></li>
								</ul>  
							</div>
						</div>
					</div>
				</div>
			</div>

	  		<br>
	  		<br>
			<span><strong>Add Associated URL's</strong></span>
			<br>
			<br>
			<%= password.simple_fields_for :urls do |u| %>
			    <%= render "url_fields", f: u %>
			<% end %>
			<div class="links">
				<%= link_to_add_association "Add URL", password, :urls, class: "btn btn-danger" %>
			</div>
	  		<br>
		</div>
	<% end %>
  </div>
</div>