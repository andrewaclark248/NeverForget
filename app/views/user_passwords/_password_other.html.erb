<div class="tab-pane fade" id="other">
    <div class="col-6">
        <div class="row">
            <div class="pb-3">
                <div class="d-inline">
                    <span class="text-secondary pe-3">Share Your Password With a Contact</span>
                    <i class="fa-solid fa fa-info-circle fa-lg" data-bs-toggle="tooltip" title="<%=@rotate_password_text%>" ></i>
                </div>
            </div>
        </div>
        <div class="row">

            <div class="col-2"></div>
            <div class="col-10">
                <button type="button" class="btn btn-dark manually-rotate-password" data-bs-toggle="modal" data-bs-target="#sharePasswordWithContact">
                    Share Your Password
                </button>
            </div>
        </div>
    </div>
</div>

    <div class="modal fade" id="sharePasswordWithContact">
        <div class="modal-dialog">
            <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Share Your Credentials</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                <div class="row pb-3">
                    <div class="col-6">
                        <span class="">Credetials You Are Sharing:</span>
                    </div>
                </div>
                <div class="row pb-3">
                    <div class="col-3">
                        <span class="text-secondary">Username: </span>
                    </div>
                    <div class="col-6">
                        <span class="text-danger"><%= password.username%></span>
                    </div>
                </div>
                <div class="row pb-3">
                    <div class="col-3">
                        <span class="text-secondary">Password:</span>
                    </div>
                    <div class="col-6">
                        <span class="text-danger"><%= password.password%></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-3">
                        <span class="text-secondary">URL's:</span>
                    </div>
                    <div class="col-6">
                        <span class="text-danger"><%= password.urls.pluck(:name).join(", ") %></span>
                    </div>
                </div>
                <hr>
                <div class="row pb-3">
                    <div class="col-6">
                            <div class="text-secondary">
                                <%= label_tag "Phone Number"%>
                            </div>
                            <%= text_field_tag :phone,"", class: "form-control contact_phone" %>
                    </div>
                </div>
            </div>
            <input id="userPasswordId" name="selected" type="hidden" value="<%= password.id %>"/>

            <!-- Modal footer -->
            <div class="modal-footer">
                    <div class="row w-100">
                        <div class="col-6">
                            <%= link_to "Share Contact", send_password_to_contact_user_password_path(password.id), method: :get, class: "btn btn-danger btn-lg btn-block w-100 sendPasswordToContact",:data => { "data-bs-dismiss": "modal"} %>
                        </div>
                        <div class="col-6">
                            <button type="button" class="btn btn-primary btn-lg btn-block w-100" data-bs-dismiss="modal">Don't Share</button>
                        </div>
                    </div>

            </div>

            </div>
        </div>
    </div>
