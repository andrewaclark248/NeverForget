<div class="tab-pane fade" id="other">




  <table class="table border-1 table-bordered" style="margin-bottom: 0rem; ">

    <tbody>
      <tr class="border-top-0">
        <td  class="border-start-0 align-middle table-row-height" style="width:40%">
			<span class="fw-bold " >Share Your Password With a Contact</span>
		    <i class="ps-2 fa-solid fa fa-info-circle fa-lg" data-bs-toggle="tooltip" title="<%=@last_updated_at_text%>" ></i>
        </td>
        <td class="align-middle border-end-0">
			<div class="row ">
				<div class="col-1"></div>
				<div class="col-8 ">
                    <button type="button" class="btn btn-dark " data-bs-toggle="modal" data-bs-target="#sharePasswordWithContact">
                        Share Your Password Via Phone
                    </button>
				</div>
			</div>
		</td>
      </tr>
	  <tr style="background: #F1F2F1;">
        <td  class="border-start-0 align-middle table-row-height" style="width:30%">
			<span class="fw-bold " >Share Your Password With a Contact</span>
		</td>
        <td class="align-middle border-end-0">
			<div class="row ">
				<div class="col-1"></div>
				<div class="col-8 ">
                    <%= mail_to "", "Send Credentials Via Email", class: "btn btn-dark",  subject: "SimpleLogins - #{password.user.full_name} Is Sending Your Credentails", body: "Hi From SimpleLogins, \n \n #{password.user.full_name} wants to share their credentials with you. Please see below. \n \n Username: #{password.username} \n \n Password: #{password.password} \n \n \n Thanks, \n SimpleLogins" %>
				</div>
			</div>
		</td>
      </tr>
    </tbody>
  </table>





</div>









    <div class="modal fade" id="sharePasswordWithContact">
        <div class="modal-dialog">
            <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header bg-dark">
                <h4 class="modal-title text-white">Share Your Credentials</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">

                <div class="row pb-3">
                    <div class="col-6">
                        <span class="">Credetials You Are Sharing:</span>
                    </div>
                </div>
				<table class="table table-bordered bg-light w-100 ">
					<tbody>
						<tr>
							<td class="fw-bold" style="width: 35%;" >
								<center>
								Username
								</center>

							</td>
							<td>
								<center>
									<span class="text-danger"><%= password.username%></span>
								</center>
							</td>
						</tr>
						<tr>
							<td class="fw-bold" style="width: 35%;" >
								<center>
								Password
								</center>

							</td>
							<td>
								<center>
									<span class="text-danger"><%= password.password%></span>
								</center>
							</td>
						</tr>
						<tr>
							<td class="fw-bold" style="width: 35%;" >
								<center>
								Password
								</center>

							</td>
							<td>
								<center>
									<span class="text-danger"><%= password.urls.pluck(:name).join(", ") %></span>
								</center>
							</td>
						</tr>
					</tbody>
				</table>
                <hr>
				<div class="pb-3">
					<span class="text-dark">*Phone Number to send credentials to</span>
				</div>
				<table class="table table-bordered bg-light w-100 ">
					<tbody>
						<tr>
							<td class="fw-bold" style="width: 35%;" >
								<center>
									<%= label_tag "Phone Number"%>
								</center>

							</td>
							<td>
								<center>
									<%= text_field_tag :phone,"", class: "form-control contact_phone w-75" %>
								</center>
							</td>
						</tr>
					</tbody>
				</table>




            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                    <div class="row w-100">
                        <div class="col-6">
                            <%= link_to "Share Contact", send_password_to_contact_user_password_path(password.id), method: :get, class: "btn btn-danger btn-lg btn-block w-100 sendPasswordToContact",:data => { "data-bs-dismiss": "modal"} %>
                        </div>
                        <div class="col-6">
                            <button type="button" class="btn btn-primary btn-lg btn-block w-100" data-bs-dismiss="modal">Don't Share</button>
                        </div>
                    </div>

            </div>

            </div>
        </div>
    </div>
