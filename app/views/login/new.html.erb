
<div class="row mb-5">
  <div class="col">
    <center>
      <%= image_tag "security-pic", style:'height:300px' %>
    </center>
  </div>
</div>

<div class="row">

    <div class="col">
    </div>
    <div class="col-5">

      	<%= simple_form_for @login, url: login_session_path do |f| %>
    		  <%= f.input :email %>
    		  <%= f.input :password %>
    		  <%= f.button :submit %>
    		<% end %>

        <%= link_to "Register", new_login_registration_path %>

    </div>
    <div class="col">
    </div>
</div>

