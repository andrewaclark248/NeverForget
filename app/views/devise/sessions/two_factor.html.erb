
  
    <div class="row">
      <div class="col-1">
      </div>
      <div class="col-11">
        <h3 class="card-title">Login</h3>
      </div>
    </div>
    <br>
    <div class="row">
      <div class="col-1">
      </div>
      <div class="col-10">
        <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name), method: :post) do |f| %>          <%= f.error_notification %>

          <div class="form-inputs">
            <%= f.input :otp_attempt, label: 'OTP' %>
          </div>
          <br>
          <center>
            <div class="form-actions">
              <%= f.submit 'Login', class: 'btn btn-danger w-100' %>
            </div>
          </center>
        <% end %>
      </div>
      <div class="col-1">
      </div>                
    </div>

