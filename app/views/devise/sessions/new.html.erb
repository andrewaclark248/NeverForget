
  
    <div class="row">
      <div class="col-12">
        <center>
        <h3 class="card-title">Login</h3>
        </center>
      </div>
    </div>
    <br>
    <div class="row">
      <div class="col-12">
        <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
          <%= f.error_notification %>

          <div class="form-inputs">

            <%= f.input :email,
                        required: false,
                        autofocus: true,
                        input_html: { autocomplete: "email" } %>
            <br>
            <div class="pb-3">
            <i class="fa-solid fa-eye errspan2 eyeIconCursor text-dark"></i>
            <%= f.input :password,
                        required: false,
                        input_html: { autocomplete: "current-password" } %>
            </div>
          </div>
          <br>
          <center>
            <div class="form-actions">
              <%= f.button :submit, "Sign In", class: "btn btn-danger w-100" %>
            </div>
          </center>
        <% end %>
      </div>
    </div>
    <br>
    <br>
    <br>
    <div class="row">
      <div class="col-6">
        <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
          <%= link_to "Sign up", new_registration_path(resource_name), class: "btn btn-outline-danger w-100" %><br />
        <% end %>                
      </div>
      <div class="col-6">
        <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
          <%= link_to "Forgot your password?", new_password_path(resource_name) %><br />
        <% end %>
      </div>
    </div>
