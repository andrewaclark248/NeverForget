		</li>
		<li style="position: fixed; bottom: 10%; width: 100%;" class="nav-btn-elm <%= is_active?("nil") %>">
			<% if is_active2?("nil") %>
				<%= link_to 'Contact Us', nil, class: 'position-absolute mx-4 nav-links-change fw-bold navbar-links', style: "font-size: 24px;"%>
			<% else %>
				<%= link_to 'Contact Us', nil, class: 'text-secondary position-absolute mx-4 nav-links-change fw-bold navbar-links', style: "font-size: 24px;"%>
			<% end %>
		</li>


