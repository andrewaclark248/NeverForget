  width: 200px;
  position: fixed;
  top: 0;
  left: 0;
  overflow-x: hidden;
  padding-top: 100px;
}



.list-nav {
  list-style-type: none;
  margin-right: 10%;
  padding: 0;
  width: 100%;
  height: 100%;
  overflow: auto;
}

li a {
  display: block;
  text-decoration: none;
}


</style>
