<!DOCTYPE html>
<html>
  <head>
    <title>Safe Logins</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= javascript_include_tag 'fontawesome-kit' %>

    <%= javascript_include_tag 'manifest' %>

    <%= javascript_include_tag 'jquery' %>

    <%= javascript_include_tag 'jquery-mask' %>

    <%= stylesheet_link_tag "bootstrap5" %>

    <%= javascript_include_tag 'bootstrap5' %>
    <%= javascript_include_tag 'clipboard' %>

    <%= javascript_include_tag 'profile' %>
    <%= javascript_include_tag 'application' %>
    <%= javascript_include_tag 'password' %>
    <%= javascript_include_tag 'dashboard' %>
    <%= javascript_include_tag 'loading-bar' %>
    
    <%= javascript_include_tag 'keyValue' %>
    <%= javascript_include_tag 'navBar' %>

    <%= stylesheet_link_tag "application" %>
    <%= stylesheet_link_tag "loading-bar" %>

    <%= javascript_pack_tag 'application' %>

  <body class="" style="position: fixed; min-width: 100%; background-color: #F8F8F8;">
      <%= render "layouts/sidenav_bar" %>


      <div class="yieldClassSmall yieldSection">
        <%= render 'layouts/topnav_bar' %>
        <%= render "shared/flash" %>
        <%= yield %>
      </div>

  </body>

</html>


