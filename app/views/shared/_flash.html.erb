<% if flash.present? %>
      <div class="pt-3 pb-3 pe-3 ps-3 <%= flash_background %> ">
            <% flash.each do |key, value| %>
                  <div class="alert-dismissible show  <%= flash_class(key) %>  border-0 flashDiv "  role="alert">
                        <span class="text-white"><%= value %></span>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                  </div>
            <% end %>
      </div>
<% end %>