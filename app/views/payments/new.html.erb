<h3>Purchase Product</h3>
<br>

<div class="row">
  <div class="col-6">
    <div class="card">
      <div class="card-header">
        Your Plan
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-4">
            <span><strong>Current Plan</strong></span>
          </div>
          <div class="col-4">
            <%= @current_plan %>
          </div>
        </div>
        <br>
        <div class="row">
          <div class="col-4">
            <span><strong>Price/Month</strong></span>
          </div>
          <div class="col-4">
            <%= Money.new(@price_per_month).format %>
          </div>
        </div>
        <br>
        <div class="row">
          <div class="col-4">
            <span><strong>Balance</strong></span>
          </div>
          <div class="col-4">
            <%= Money.new(@balance).format %>
          </div>
        </div>
        <br>
        <hr>
        <%= link_to "Want to cancel your plan?", billing_portal_index_path %><br /><br />
      </div>
    </div>
  </div>
  <div class="col-6">
    <div class="card">
      <div class="card-header">
        Billing Portal
      </div>
      <div class="card-body">
        <ul>
          <li>Need to cancel your plan?</li>
          <li>Need to upgrade your payment method?</li>
          <li>Want to view you invoice/payment history?</li>
        </ul> 
        <hr>
        <center>
          <%= link_to "Go To Our Billing Portal!", billing_portal_index_path %><br />
        </center>
      </div>
    </div>
  </div>
</div>
<br>
<br>



<div class="row">
  <div class="col-10">
    <div class="card">
      <div class="card-header">
        Upgrade/Change Your Plan
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-5">
            <span><strong>Plan</strong></span>
          </div>
          <div class="col-3">
            <span><strong># of Phones</strong></span>
          </div>
          <div class="col-4">
            <span><strong>Price/Month</strong></span>
          </div>
        </div>
        <hr>
        <div class="row">
          <div class="col-5">
            <div class="row">
              <div class="col-6">
                <span>Current Plan:</span>
              </div>
              <div class="col-6">
                <span><strong class="text-primary"><%= @current_plan %></strong></span>
              </div>
            </div>
          </div>
          <div class="col-3">
            <%= "#{get_phones_based_on_plan(@current_plan)}" %>
          </div>
          <div class="col-4">
            <%= "#{Money.new(@current_plan).format}/Month" %>
          </div>
        </div>
        <hr>
        <br>
        <div class="row">
          <div class="col-5">
            <div class="row">
              <div class="col-6">
                <span>Selected Plan:</span>
              </div>
              <div class="col-6">
                <%= simple_form_for :payment, url: payments_path, input_html: { id: "order-details" } do |f| %>
                  <%= f.collection_select :plan, @plans, :name, :name, include_blank: true %>
                  <br>
                  <br>
                  <br>
                  <br>
                  <%= f.submit "Update Plan", data: { confirm: "Are you sure you wannt to update your plan?" }, class: "btn btn-danger" %>
                <% end %>
              </div>
            </div>
          </div>
          <div class="col-3">
            <span id="phone-count">0 Phones</span>
          </div>
          <div class="col-4">
            <span id="upgraded-plan" class="text-danger">
              <%= "No Plan Selected!" %>
            </span>
          </div>
        </div>
        <br>
      </div>
    </div>
  </div>
</div>
<br>
<br>





