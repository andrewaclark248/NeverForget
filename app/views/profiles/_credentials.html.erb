


<table class="table border-1 table-bordered" style="margin-bottom: 0rem; ">

	<tbody>
		<tr class="border-top-0">
			<td  class="border-start-0 align-middle table-row-height" style="width:40%">
				<span class="fw-bold " >First Name</span>
			</td>
			<td class="align-middle border-end-0">
				<div class="row ">
					<div class="col-1"></div>
					<div class="col-6 ">
						<%= f.input :first, wrapper_html: {class: ""}, as: :string, label: false %>
					</div>
				</div>
			</td>
		</tr>
		<tr>
			<td  class="border-start-0 align-middle table-row-height" style="width:30%">
				<span class="fw-bold">Last Name</span>
			</td>
			<td class="align-middle border-end-0">
				<div class="row ">
					<div class="col-1"></div>
					<div class="col-6 ">
						<%= f.input :last, wrapper_html: {class: ""}, as: :string, label: false %>
					</div>
				</div>
			</td>
		</tr>
		<tr>
			<td  class="border-start-0 align-middle table-row-height" style="width:30%">
				<span class="fw-bold " >Email Address</span>
			</td>
			<td class="align-middle border-end-0">
				<div class="row ">
					<div class="col-1"></div>
					<div class="col-6">
						<%= f.input :email, input_html: {value: user.login.email }, as: :string, label: false %>
					</div>
					<div class="col-4 ">
						<button class="btn btn-dark sendTestEmail" type="button">
							<span>Send Test Email</span>
						</button>
					</div>
				</div>
			</td>
		</tr>
		<tr class="border-top-0">
			<td  class="border-start-0 align-middle table-row-height" style="width:40%">
				<span class="fw-bold ">Change Password</span>
			</td>
			<td class="align-middle border-end-0">
				<div class="row ">
					<div class="col-1"></div>
					<div class="col-8 ">
						<button type="button" class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#changeYourPassword">
							<span>Change My Password</span>
						</button>
					</div>
				</div>
			</td>
		</tr>
	</tbody>
</table>


