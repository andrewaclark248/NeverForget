



  <table class="table border-1 table-bordered accordionTable" >

    <tbody>
		<tr class="border-top-0">
			<td  class="border-start-0 align-middle table-row-height accordionCol1Width">
				<span class="fw-bold " >Multi Factor Authentication</span>
			</td>
			<td class="align-middle border-end-0">
				<div class="row ">
					<div class="col-1"></div>
					<div class="col-3">
						<span class="fw-bold text-danger"><%= user.login.otp_required_for_login ? "Enabled" : "Disabled" %>
					</div>
					<div class="col-4 ">
						<center>
						<button type="button" class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#mfaModal">
							Configure MFA
						</button>
						</center>				
					</div>
				</div>
			</td>
		</tr>
		<tr>
			<td  class="border-start-0 align-middle table-row-height accordionCol1Width">
				<span class="fw-bold " >Disable Chrome Password Save</span>
			</td>
			<td class="align-middle border-end-0">
				<div class="row ">
					<div class="col-1"></div>
					<div class="col-8 ">
							<span class="fw-bold text-danger"><%= user.chrome_pwd_manager_value %></span>
					</div>
				</div>
			</td>
		</tr>
		<tr>
			<td  class="border-start-0 align-middle table-row-height accordionCol1Width">
				<span class="fw-bold " >Chrome extension auto logoff</span>
			</td>
			<td class="align-middle border-end-0">
				<div class="row ">
					<div class="col-1"></div>
					<div class="col-4 ">
						<%= f.select :chrome_ext_auto_logoff, [["2 Weeks","2"], ["3 Weeks", "3"], ["4 Weeks", "4"]], {selected: user.chrome_ext_auto_logoff}, {class: "form-select"} %>
					</div>
				</div>
			</td>
		</tr>
		<tr>
			<td class="align-middle">
				<span class="fw-bold"> Block Tor Browsers</span>
			</td>
			<td class="align-middle">
				<div class="row ">
					<div class="col-1"></div>
					<div class="col-8 ">
						<div class="btn-group" role="group" aria-label="Basic radio toggle button group">
							<%= f.radio_button :enable_tor, 'enable_tor', class: "btn-check", id: "enable_tor", checked: user.login.enable_tor %> 
							<label class="btn btn-outline-danger" for="enable_tor">Enabled</label>
							
							<%= f.radio_button :enable_tor, 'disable_tor', class: "btn-check", id: "disable_tor", checked: !user.login.enable_tor %> 
							<label class="btn btn-outline-danger" for="disable_tor">Disabled</label>
						</div>
					</div>
				</div>
			</td>
		</tr>
    </tbody>
  </table>


