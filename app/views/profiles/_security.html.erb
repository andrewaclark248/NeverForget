
<div class="tab-pane fade" id="profile">
    <div class="row">
        <div class="col-6">
            <div class="row">
                <div class="pb-3">
                    <div class="d-inline">
                        <span class="text-secondary pe-3">Multi Factor Authentication</span>
                        <i class="fa-solid fa fa-info-circle fa-lg" data-bs-toggle="tooltip" title="<%=@rotate_password_text%>" ></i>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-2"></div>
                <div class="col-10">
                    <button type="button" class="btn btn-dark manually-rotate-password" data-bs-toggle="modal" data-bs-target="#mfaModal">
                        Configure MFA
                    </button>
                </div>
            </div>
        </div>

        <div class="col-6">
            <div class="row">
                <div class="pb-3">
                    <div class="d-inline">
                        <span class="text-secondary pe-3">Disable chrome password save</span>
                        <i class="fa-solid fa fa-info-circle fa-lg" data-bs-toggle="tooltip" title="<%=@rotate_password_text%>" ></i>
                    </div>
                </div>
            </div>
            <div class="row">
                <span class="fw-bold"><%= user.chrome_pwd_manager_value %></span>
            </div>
        </div>
    </div>
    <hr>
    <div class="row">
        <div class="col-6">
            <div class="row">
                <div class="pb-3">
                    <div class="d-inline">
                        <span class="text-secondary pe-3">Chrome extension auto logoff</span>
                        <i class="fa-solid fa fa-info-circle fa-lg" data-bs-toggle="tooltip" title="<%=@rotate_password_text%>" ></i>
                    </div>
                </div>
            </div>
            <div class="row">


            <div>

                <div class="btn-group" role="group" aria-label="Basic checkbox toggle button group">
                    <input type="checkbox" class="btn-check" id="btncheck1" autocomplete="off">
                    <label class="btn btn-outline-danger" for="btncheck1">1 Week</label>

                    <input type="checkbox" class="btn-check" id="btncheck2" autocomplete="off">
                    <label class="btn btn-outline-danger" for="btncheck2">3 Weeks</label>

                    <input type="checkbox" class="btn-check" id="btncheck3" autocomplete="off">
                    <label class="btn btn-outline-danger" for="btncheck3">2 Months</label>
                </div>
            </div>



            </div>
        </div>
    </div>
</div>



<div class="modal fade" id="mfaModal">
  <div class="modal-dialog">
    <div class="modal-content">

      <!-- Modal Header -->
      <div class="modal-header bg-light">
        <h4 class="modal-title">Delete Password</h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <!-- Modal body -->
      <div class="modal-body bg-light">
	  	<div class="row pb-3">
			<span class="text-dark">
				Are you sure you want to delete the following <span class="fw-bold">Username</span> & <span class="fw-bold">Password</span>?
			</span>
		</div>
		<div class="row pb-2">
			<div class="col-3">
				<span class="text-dark">Username: </span>
			</div>
			<div class="col-9">
				<strong><span class="current-username text-danger"></span></strong>
			</div>
		</div>
		<div class="row ">
			<div class="col-3">
				<span class="text-dark">Password: </span>
			</div>
			<div class="col-9">
				<strong><span class="current-password text-danger"></span></strong>
			</div>
		</div>
        <br>
      </div>

      <!-- Modal footer -->
      <div class="modal-footer bg-light">
	  		<div class="row w-100">
			  	<div class="col-6">
					<%= link_to "Yes", user_password_path(12), method: :delete, class: "btn btn-danger btn-lg btn-block w-100 delete-password-accept",:data => { "data-bs-dismiss": "modal"} %>
			    </div>
				<div class="col-6">
					<button type="button" class="btn btn-primary btn-lg btn-block w-100" data-bs-dismiss="modal">No</button>
				</div>
			</div>

	  </div>

    </div>
  </div>
</div>

