



  <table class="table border-1 table-bordered" style="margin-bottom: 0rem; ">

    <tbody>
      <tr class="border-top-0">
        <td  class="border-start-0 align-middle table-row-height" style="width:40%">
			<span class="fw-bold " >Multi Factor Authentication</span>
        </td>
        <td class="align-middle border-end-0">
			<div class="row ">
				<div class="col-1"></div>
				<div class="col-8 ">
                    <button type="button" class="btn btn-dark " data-bs-toggle="modal" data-bs-target="#mfaModal">
                        Configure MFA
                    </button>				
                </div>
			</div>
		</td>
      </tr>
	  <tr style="background: #F1F2F1;">
        <td  class="border-start-0 align-middle table-row-height" style="width:30%">
			<span class="fw-bold " >Disable Chrome Password Save</span>
		</td>
        <td class="align-middle border-end-0">
			<div class="row ">
				<div class="col-1"></div>
				<div class="col-8 ">
                        <span class="fw-bold text-danger"><%= user.chrome_pwd_manager_value %></span>
				</div>
			</div>
		</td>
      </tr>
      <tr>
        <td  class="border-start-0 align-middle table-row-height" style="width:30%">
			<span class="fw-bold " >Chrome extension auto logoff</span>
		</td>
        <td class="align-middle border-end-0">
			<div class="row ">
				<div class="col-1"></div>
				<div class="col-4 ">
					<%= f.select :chrome_ext_auto_logoff, [["2 Weeks","2"], ["3 Weeks", "3"], ["4 Weeks", "4"]], {selected: user.chrome_ext_auto_logoff}, {class: "form-select"} %>
                </div>
			</div>
		</td>
      </tr>
    </tbody>
  </table>





<div class="modal fade" id="mfaModal">
  <div class="modal-dialog">
    <div class="modal-content">

      <!-- Modal Header -->
      <div class="modal-header bg-light">
        <h4 class="modal-title">Delete Password</h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <!-- Modal body -->
      <div class="modal-body bg-light">
	  	<div class="row pb-3">
			<span class="text-dark">
				Are you sure you want to delete the following <span class="fw-bold">Username</span> & <span class="fw-bold">Password</span>?
			</span>
		</div>
		<div class="row pb-2">
			<div class="col-3">
				<span class="text-dark">Username: </span>
			</div>
			<div class="col-9">
				<strong><span class="current-username text-danger"></span></strong>
			</div>
		</div>
		<div class="row ">
			<div class="col-3">
				<span class="text-dark">Password: </span>
			</div>
			<div class="col-9">
				<strong><span class="current-password text-danger"></span></strong>
			</div>
		</div>
        <br>
      </div>

      <!-- Modal footer -->
      <div class="modal-footer bg-light">
	  		<div class="row w-100">
			  	<div class="col-6">
					<%= link_to "Yes", user_password_path(12), method: :delete, class: "btn btn-danger btn-lg btn-block w-100 delete-password-accept",:data => { "data-bs-dismiss": "modal"} %>
			    </div>
				<div class="col-6">
					<button type="button" class="btn btn-primary btn-lg btn-block w-100" data-bs-dismiss="modal">No</button>
				</div>
			</div>

	  </div>

    </div>
  </div>
</div>

