<div class="row ps-3 pe-3 pb-5 pt-4 pb-3 border-bottom border-dark" >
	<div class="col-6">
		<span class="fs-5 fw-bold">Profile</span>
	</div>
	<div class="col-6 ">
	</div>
</div>

<%= simple_form_for @user, url: update_login_profile_path(@user), method: :post do |f| %>
    <div class="accordion accordion-flush border-bottom border-dark" id="accordionExample">
        <div class="accordion-item ">
            <h2 class=" " id=""  style="margin-bottom: 0px;">
            <button class="accordion-button bg-danger collapsed shadow"  style="	" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                <span class="text-dark fw-bold">Credentials</span>
            </button>
            </h2>
            <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#accordionExample">
                <%= render "credentials", f: f, user: @user%>
            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingTwo">
            <button class="accordion-button collapsed bg-secondary rounded-0 shadow" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                <span class="fw-bold text-dark">Security</span>
            </button>
            </h2>
            <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#accordionExample">
                <%= render "security", user: @user, f: f %>
            </div>
        </div>

    </div>
    <div class="row pb-4 pt-5" style="  border-top: solid #C0C0C0;">
        <div class="col-2"></div>
        <div class="col-8 ">
            <center>
                <div class="d-grid gap-2">
					<%=f.submit "Update Profile",class: "btn btn-danger"%>
                </div>
            </center>
        </div>
        <div class="col-2"></div>
    </div>
<% end %>

<%= render "reset_password_modal", user: @user %>

<%= simple_form_for @user, url: configure_mfa_profile_path(@user), method: :post do |f| %>

    <div class="modal fade" id="mfaModal">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header bg-dark">
                    <h4 class="modal-title text-white">Configure Multi-Factor-Auth</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <!-- Modal body -->
                <div class=" bg-light">
                    <table class="table table-bordered" style="margin-bottom: 0px;">
                        <tbody>
                            <tr class="table-height">
                                <td class="align-middle">
                                    <center>
                                        <span class="fw-bold">MFA Enabled</span>
                                    </center>
                                </td>
                                <td class="align-middle">
                                    <center>
                                        <div class="btn-group" role="group" aria-label="Basic radio toggle button group">
                                            <%= f.radio_button :mfa_enabled, 'mfa_enabled', class: "btn-check", id: "mfaEnabled", checked: @user.login.otp_required_for_login %> 
                                            <label class="btn btn-outline-danger" for="mfaEnabled">Enabled</label>
                                            
                                            <%= f.radio_button :mfa_enabled, 'mfa_disabled', class: "btn-check", id: "mfaDisabled", checked: !@user.login.otp_required_for_login %> 
                                            <label class="btn btn-outline-danger" for="mfaDisabled">Disabled</label>
                                        </div>
                                    </center>
                                </td>
                            </tr>
                            <tr class="table-height mfaSendMethod <%= @show_send_option %>">
                                <td class="align-middle">
                                    <center>
                                        <span class="fw-bold">Get Code Via Phone or Email</span>
                                    </center>
                                </td>
                                <td>
                                    <center>
                                        <div class="btn-group" role="group" aria-label="Basic radio toggle button group">
                                            <%= f.radio_button :mfa_send_option, 'phone', class: "btn-check", id: "mfaPhone", checked: @mfa_send_option_is_phone %> 
                                            <label class="btn btn-outline-danger" for="mfaPhone">Phone</label>
                                            
                                            <%= f.radio_button :mfa_send_option, 'email', class: "btn-check", id: "mfaEmail", checked: !@mfa_send_option_is_phone %> 
                                            <label class="btn btn-outline-danger" for="mfaEmail">Email</label>
                                        </div>
                                    </center>
                                </td>
                            </tr>
                            <tr class="table-height mfaEmail <%= @show_email_field %>">
                                <td class="align-middle">
                                    <center>
                                        <span class="fw-bold">Email</span>
                                    </center>
                                </td>
                                <td>
                                    <center>
                                        <%= f.input :mfa_email, label: false, :input_html => { value: @mfa_email_value } %>
                                    </center>
                                </td>
                            </tr>
                            <tr class="table-height mfaPhone <%= @show_phone_field  %>">
                                <td class="align-middle">
                                    <center>
                                        <span class="fw-bold">Phone</span>
                                    </center>
                                </td>
                                <td class="align-middle">
                                    <center>
                                        <%= f.input :mfa_phone, label: false, :input_html => { value: @mfa_phone_value } %>
                                    </center>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Modal footer -->
                <div class="modal-footer bg-light">
                        <div class="row w-100">
                            <div class="col-6">
                                <%= f.submit "Add MFA To Profile", class: "btn btn-danger btn-lg btn-block w-100",:data => { "data-bs-dismiss": "modal"} %>
                            </div>
                            <div class="col-6">
                                <button type="button" class="btn btn-primary btn-lg btn-block w-100" data-bs-dismiss="modal">Cancel</button>
                            </div>
                        </div>
                </div>

            </div>
        </div>
    </div>


<% end %>
