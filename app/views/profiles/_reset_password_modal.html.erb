<%= simple_form_for user, url: reset_password_profile_path(user), method: :post do |f| %>

    <div class="modal fade" id="changeYourPassword">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header bg-dark">
                <h4 class="modal-title text-white">Change Your Password</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">

                <div class="row pb-3">
                    <div class="col-6">
                        <span class="">Change Your Password To:</span>
                    </div>
                </div>
				<table class="table table-bordered bg-light w-100 ">
					<tbody>
						<tr>
							<td class="fw-bold accordionCol1Width" >
								<center>
								    New Password
								</center>
							</td>
							<td>
                                <div class="row">
                                    <div class="col-1"></div>
                                    <div class="col-8">
                                        <i class="fa-solid fa-eye errspan3 eyeIconCursorProfile text-dark"></i>
                                        <%= f.input :password, label: false %>
                                    </div>
                                </div>
							</td>
						</tr>
						<tr>
							<td class="fw-bold accordionCol1Width" >
								<center>
								    Confirm New Password
								</center>
							</td>
							<td>
                                <div class="row">
                                    <div class="col-1"></div>
                                     <div class="col-8">
                                        <i class="fa-solid fa-eye errspan3 eyeIconCursorProfileConfirm text-dark"></i>
                                        <%= f.input :password_confirmation, label: false%>
                                     </div>
                                </div>
							</td>
						</tr>
					</tbody>
				</table>
            </div> 

            <!-- Modal footer -->
            <div class="modal-footer">
                <div class="row w-100">
                    <div class="col-6">
                        <%= f.submit "Chnage Password", class:  "btn btn-danger btn-lg btn-block w-100", :data => { "data-bs-dismiss": "modal"} %>
                    </div>
                    <div class="col-6">
                        <button type="button" class="btn btn-primary btn-lg btn-block w-100" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </div>
            </div>

            </div>
        </div>
    </div>
<% end %>